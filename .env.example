# PostgreSQL Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=hsg_math
POSTGRES_HOST=postgres-db
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:postgres@postgres-db:5432/hsg_math

# Redis Configuration
REDIS_HOST=redis-broker
REDIS_PORT=6379
CELERY_BROKER_URL=redis://redis-broker:6379/0
CELERY_RESULT_BACKEND=redis://redis-broker:6379/0

# MinIO Configuration
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_ENDPOINT=minio-storage:9000
MINIO_PUBLIC_ENDPOINT=localhost:9000
MINIO_BUCKET_NAME=hsg-math-assets
MINIO_USE_SSL=false

# LLM Configuration (OmniRoute / OpenAI Compatible OR Native Gemini)
# Option 1: OmniRoute / OpenAI compatible endpoint
OMNIROUTE_API_KEY=your_omniroute_api_key_here
OMNIROUTE_BASE_URL=https://api.omniroute.ai/v1
OMNIROUTE_VISION_MODEL=gemini-2.5-pro
OMNIROUTE_EMBEDDING_MODEL=text-embedding-3-small

# Option 2: Native Google Gemini API
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-pro
GEMINI_EMBEDDING_MODEL=text-embedding-004

# Service Ports
CORE_API_PORT=8000
EXPORT_SERVICE_PORT=8001
FRONTEND_PORT=3000
